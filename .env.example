# 🔒 GÜVENLIK UYARISI: Bu dosyayı .env.local olarak kopyalayın ve gerçek değerlerle doldurun!
# .env.local dosyasını asla Git'e eklemeyin!

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/find-the-fear
# Production: mongodb+srv://username:password@cluster.mongodb.net/database

# JWT Secret (Production'da mutlaka değiştirin!)
# Güçlü bir secret oluşturmak için: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-very-strong-secret-key-here-minimum-64-characters

# Gemini API (AI öneriler için)
GEMINI_API_KEY=your-gemini-api-key-here

# Environment
NODE_ENV=development
# Production'da: production

# Redis (Opsiyonel - Rate limiting için)
# REDIS_URL=redis://localhost:6379

# Email (Opsiyonel - Şifre sıfırlama için)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: https://findthefear.com

# Cookie Domain (Production için)
# COOKIE_DOMAIN=.findthefear.com
